# Local Spring Boot settings. Start-TaskFlow.ps1 creates the actual file in LocalAppData.
# JWT signing key must be Base64-encoded and contain at least 32 random bytes.
TASKFLOW_JWT_KEY=

# Separate code for the pending demo-account registration only.
TASKFLOW_DEMO_CLAIM_CODE=

# Password for both Docker Compose PostgreSQL and the Spring Boot datasource.
DATABASE_PASSWORD=
